# Matter: event timestamp (EpochTimestamp) in milliseconds since 1970, on 64 bits, as the
# specification requires. Tasmota sends seconds on 32 bits: a button press then seems to
# date from January 1970, and Google Home does not run the automation (tested with a virtual
# Matter button and Google Home).
--- a/lib/libesp32/berry_matter/src/embedded/Matter_EventHandler.be	2026-11-05 14:32:02.787310296 +0000
+++ b/lib/libesp32/berry_matter/src/embedded/Matter_EventHandler.be	2026-11-05 14:32:02.853590652 +0000
@@ -117,8 +117,11 @@
     raw.add(0x2402, -2)           # add 2402
     raw.add(priority, 1)          # add priority as one byte
     # EpochTimestamp
-    raw.add(0x2603, -2)           # add 2603
-    raw.add(epoch_timestamp, 4)   # add epoch as 32 bits
+    # Matter expects milliseconds since 1970 (uint64), not seconds
+    raw.add(0x2703, -2)           # add 2703
+    var epoch_ms = int64(epoch_timestamp) * int64(1000)
+    raw.add(epoch_ms.low32(), 4)  # int64 low part
+    raw.add(epoch_ms.high32(), 4) # int64 high part
     # Data struct
     raw.add(0x3507, -2)           # add 3507
 
